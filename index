<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HeadMouse MG24 - Control Seguro</title>
  <style>
    :root { --primary: #2563eb; --success: #10b981; --bg: #f8fafc; --card: #ffffff; --text: #0f172a; }
    * { box-sizing: border-box; font-family: system-ui, sans-serif; }
    body { margin: 0; padding: 20px; background: var(--bg); color: var(--text); display: flex; justify-content: center; }
    .container { max-width: 820px; width: 100%; display: grid; gap: 20px; }
    .header { background: var(--card); padding: 20px 28px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
    .btn-connect { background: var(--primary); color: white; border: none; padding: 14px 24px; border-radius: 12px; font-size: 16px; font-weight: 600; cursor: pointer; }
    .badge { font-size: 13px; padding: 4px 12px; border-radius: 20px; background: #fee2e2; color: #991b1b; font-weight: 600; }
    .badge.connected { background: #d1fae5; color: #065f46; }
    .main-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 20px; }
    @media (max-width: 720px) { .main-grid { grid-template-columns: 1fr; } }
    .card { background: var(--card); padding: 24px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); }
    .radar-box { display: flex; flex-direction: column; align-items: center; text-align: center; }
    canvas#radar { background: #f1f5f9; border-radius: 50%; border: 2px solid #cbd5e1; margin: 10px 0; }
    .control-group { margin-bottom: 20px; }
    .control-header { display: flex; justify-content: space-between; font-weight: 600; margin-bottom: 6px; }
    input[type="range"] { width: 100%; height: 10px; cursor: pointer; }
    .btn-recal { width: 100%; padding: 16px; background: var(--success); color: white; border: none; border-radius: 12px; font-size: 16px; font-weight: 700; cursor: pointer; margin-top: 10px; }
    .disabled-panel { opacity: 0.4; pointer-events: none; }
  </style>
</head>
<body>

<div class="container">
  <div class="header">
    <h1>👓 HeadMouse MG24 <span id="statusBadge" class="badge">Bloqueado</span></h1>
    <button id="btnConnect" class="btn-connect">🔒 Conectar con PIN</button>
  </div>

  <div id="mainPanel" class="main-grid disabled-panel">
    <div class="card radar-box">
      <h2>🎯 Radar de Movimiento en Vivo</h2>
      <canvas id="radar" width="240" height="240"></canvas>
      <p style="font-size: 13px; color: #64748b;">
        <strong>Punto Verde:</strong> Posición actual de tu cabeza.<br>
        <strong>Zona Azul:</strong> Área segura que bloquea temblores.
      </p>
      <button id="btnRecal" class="btn-recal">🔄 Centrar Postura Ahora</button>
    </div>

    <div class="card">
      <h2>🎛️ Calibración Visual</h2>
      <div class="control-group">
        <div class="control-header"><span>🛡️ Zona Segura (Deadzone)</span><span id="lblDeadzone">2.5°</span></div>
        <input type="range" id="deadzone" min="0" max="12" step="0.5" value="2.5">
      </div>
      <div class="control-group">
        <div class="control-header"><span>🌊 Amortiguación de Temblor</span><span id="lblSmooth">80%</span></div>
        <input type="range" id="smooth" min="0" max="0.95" step="0.05" value="0.80">
      </div>
      <div class="control-group">
        <div class="control-header"><span>↔️ Velocidad Horizontal</span><span id="lblSensX">1.2x</span></div>
        <input type="range" id="sensX" min="0.3" max="3.5" step="0.1" value="1.2">
      </div>
      <div class="control-group">
        <div class="control-header"><span>↕️ Velocidad Vertical</span><span id="lblSensY">1.2x</span></div>
        <input type="range" id="sensY" min="0.3" max="3.5" step="0.1" value="1.2">
      </div>
    </div>
  </div>
</div>

<script>
  const SERVICE_UUID = "19b10000-e8f2-537e-4f6c-d104768a1214";
  const UUIDS = {
    deadzone: "19b10001-e8f2-537e-4f6c-d104768a1214",
    smooth:   "19b10002-e8f2-537e-4f6c-d104768a1214",
    sensX:    "19b10003-e8f2-537e-4f6c-d104768a1214",
    sensY:    "19b10004-e8f2-537e-4f6c-d104768a1214",
    recal:    "19b10005-e8f2-537e-4f6c-d104768a1214",
    pin:      "19b10006-e8f2-537e-4f6c-d104768a1214",
    livePos:  "19b10007-e8f2-537e-4f6c-d104768a1214"
  };

  let chars = {};
  let currentDeadzone = 2.5;
  let headX = 0, headY = 0;

  const canvas = document.getElementById('radar');
  const ctx = canvas.getContext('2d');

  function drawRadar() {
    const cx = canvas.width / 2;
    const cy = canvas.height / 2;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Ejes
    ctx.strokeStyle = "#cbd5e1";
    ctx.beginPath();
    ctx.moveTo(cx, 0); ctx.lineTo(cx, canvas.height);
    ctx.moveTo(0, cy); ctx.lineTo(canvas.width, cy);
    ctx.stroke();

    // Zona Segura (Deadzone)
    const radius = Math.max(8, (currentDeadzone / 12) * 95);
    ctx.fillStyle = "rgba(37, 99, 235, 0.18)";
    ctx.strokeStyle = "#2563eb";
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(cx, cy, radius, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();

    // Punto Verde (Cabeza en tiempo real)
    const scale = 95 / 12;
    const px = Math.max(10, Math.min(canvas.width - 10, cx + (headX * scale)));
    const py = Math.max(10, Math.min(canvas.height - 10, cy + (headY * scale)));

    ctx.fillStyle = "#10b981";
    ctx.beginPath();
    ctx.arc(px, py, 8, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = "#065f46";
    ctx.stroke();
  }

  drawRadar();

  document.getElementById('btnConnect').addEventListener('click', async () => {
    const userPin = prompt("Ingresa el PIN de seguridad de los lentes (4 dígitos):");
    if (!userPin) return;

    try {
      const device = await navigator.bluetooth.requestDevice({
        filters: [{ name: 'HeadMouse-MG24' }],
        optionalServices: [SERVICE_UUID]
      });

      const server = await device.gatt.connect();
      const service = await server.getPrimaryService(SERVICE_UUID);

      for (let key in UUIDS) {
        chars[key] = await service.getCharacteristic(UUIDS[key]);
      }

      // Enviar PIN de autenticación
      const pinBuf = new ArrayBuffer(4);
      new DataView(pinBuf).setUint32(0, parseInt(userPin), true);
      await chars.pin.writeValue(pinBuf);

      // Escuchar datos del Radar en vivo
      await chars.livePos.startNotifications();
      chars.livePos.addEventListener('characteristicvaluechanged', (e) => {
        const view = e.target.value;
        headX = view.getFloat32(0, true);
        headY = view.getFloat32(4, true);
        drawRadar();
      });

      const badge = document.getElementById('statusBadge');
      badge.innerText = "Desbloqueado";
      badge.classList.add('connected');
      document.getElementById('mainPanel').classList.remove('disabled-panel');
    } catch (err) {
      alert("Acceso denegado o PIN incorrecto.");
    }
  });

  async function sendFloat(key, val) {
    if (!chars[key]) return;
    const buf = new ArrayBuffer(4);
    new DataView(buf).setFloat32(0, parseFloat(val), true);
    await chars[key].writeValue(buf);
  }

  document.getElementById('deadzone').addEventListener('input', (e) => {
    currentDeadzone = parseFloat(e.target.value);
    document.getElementById('lblDeadzone').innerText = currentDeadzone + "°";
    drawRadar();
    sendFloat('deadzone', currentDeadzone);
  });

  document.getElementById('smooth').addEventListener('input', (e) => {
    document.getElementById('lblSmooth').innerText = Math.round(e.target.value * 100) + "%";
    sendFloat('smooth', e.target.value);
  });

  document.getElementById('sensX').addEventListener('input', (e) => {
    document.getElementById('lblSensX').innerText = e.target.value + "x";
    sendFloat('sensX', e.target.value);
  });

  document.getElementById('sensY').addEventListener('input', (e) => {
    document.getElementById('lblSensY').innerText = e.target.value + "x";
    sendFloat('sensY', e.target.value);
  });

  document.getElementById('btnRecal').addEventListener('click', async () => {
    if (!chars.recal) return;
    await chars.recal.writeValue(new Uint8Array());
  });
</script>
</body>
</html>
